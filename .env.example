# ══════════════════════════════════════════════════════════════════════════════
# Songtai Life — environment variable reference
# Copy this file to .env and fill in real values for local development.
# In production, set these as secrets/environment variables in your host's UI
# (Vercel → Project Settings → Environment Variables, Netlify → Site settings
# → Environment variables, etc.).  Never commit a .env file with real values.
# ══════════════════════════════════════════════════════════════════════════════

# ── Site ──────────────────────────────────────────────────────────────────────

# The canonical public URL of this deployment (no trailing slash).
# Used for referral links, WhatsApp messages, sitemap.xml, robots.txt.
# Must match the actual domain where the app is reachable.
# Client-side Vite equivalent: VITE_SITE_URL (set the same value).
SITE_URL="https://songtailife.cm"
VITE_SITE_URL="https://songtailife.cm"

# ── Supabase ──────────────────────────────────────────────────────────────────

# Your Supabase project URL.  Found in Project Settings → API → Project URL.
SUPABASE_URL="https://<project-ref>.supabase.co"

# Supabase anonymous/public key.  Safe to expose to browsers.
# Found in Project Settings → API → Project API keys → anon / public.
SUPABASE_ANON_KEY="eyJ..."

# Supabase service-role key.  SECRET — never expose this to browsers.
# Found in Project Settings → API → Project API keys → service_role.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ── Google Gemini AI ──────────────────────────────────────────────────────────

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY="AIza..."

# ── MeSomb payment gateway ────────────────────────────────────────────────────

# All three values are available in your MeSomb developer dashboard.
MESOMB_API_KEY="your_mesomb_api_key"
MESOMB_APPLICATION_KEY="your_mesomb_application_key"

# Used to verify the HMAC-SHA256 signature on incoming payment webhooks.
MESOMB_SIGNATURE_KEY="your_mesomb_webhook_signature_key"

# ── Twilio (WhatsApp notifications) ──────────────────────────────────────────

# Twilio Account SID — starts with "AC".  Found in the Twilio Console dashboard.
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Twilio Auth Token.  Found in the Twilio Console dashboard.
TWILIO_AUTH_TOKEN="your_twilio_auth_token"

# WhatsApp-enabled Twilio phone number in E.164 format, prefixed with "whatsapp:".
# Use the Twilio Sandbox number during development: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM="whatsapp:+1234567890"

# ── Sessions ──────────────────────────────────────────────────────────────────

# Secret used to sign session cookies.  Generate a strong random string:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# ── Admin bootstrap ───────────────────────────────────────────────────────────

# One-time secret required to call POST /api/admin/bootstrap-superadmin.
# Once the first superadmin exists this endpoint becomes permanently disabled
# regardless of this key.  Set any strong random string; rotate after first use.
ADMIN_BOOTSTRAP_KEY="change-me-after-first-use"

# ── Domain provider (custom-domain automation) ────────────────────────────────

# Selects which platform's domain API is used to manage partner custom domains.
# Allowed values: vercel | netlify | none
# Default: vercel
# Set to "none" to disable custom-domain automation (partner sites still work
# via their slug URL; only the custom-domain attachment/verification flow is
# skipped).
DOMAIN_PROVIDER="vercel"

# Required when DOMAIN_PROVIDER=vercel.
# VERCEL_API_TOKEN: a Vercel personal access token with project write scope.
#   Create one at https://vercel.com/account/tokens
# VERCEL_PROJECT_ID: the project ID shown in your Vercel project settings.
VERCEL_API_TOKEN="your_vercel_api_token"
VERCEL_PROJECT_ID="prj_xxxxxxxxxxxxxxxxxxxx"

# ── Scheduled jobs ────────────────────────────────────────────────────────────

# Bearer token required to invoke scheduled job endpoints such as
# GET /api/cron/check-partner-domains.
# Set to any strong random string.  Use the same value in your external
# scheduler (GitHub Actions, cron-job.org, Supabase pg_cron, Vercel Cron, etc.).
# If unset, the endpoint is open — fine for local dev, not for production.
CRON_SECRET="change-me-to-a-long-random-string"

# ── Platform detection (serverless hosts) ─────────────────────────────────────

# Vercel and Netlify inject their own flags (VERCEL=1, NETLIFY=true)
# automatically — you do NOT set those yourself.
# If deploying to another serverless host that imports server.ts as a module
# handler, set this to any non-empty value to suppress app.listen():
# SERVERLESS_PLATFORM="1"

# ── Optional / local dev ──────────────────────────────────────────────────────

# TCP port for the Express server when running locally.  Defaults to 5000.
# PORT=5000
